	$(AM_V_CC)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(sacio_CFLAGS) $(CFLAGS) -c -o sacio-sacio.o `test -f 'sacio.c' || echo '$(srcdir)/'`sacio.c

