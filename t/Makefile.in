	$(AM_V_at)-rm -f libunit.a
	$(AM_V_AR)$(libunit_a_AR) libunit.a $(libunit_a_OBJECTS) $(libunit_a_LIBADD)
	$(AM_V_at)$(RANLIB) libunit.a

clean-checkPROGRAMS:
	-test -z "$(check_PROGRAMS)" || rm -f $(check_PROGRAMS)

