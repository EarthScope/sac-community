	$(AM_V_CC)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(sacio_CFLAGS) $(CFLAGS) -c -o sacio-sacio.obj `if test -f 'sacio.c'; then $(CYGPATH_W) 'sacio.c'; else $(CYGPATH_W) '$(srcdir)/sacio.c'; fi`

