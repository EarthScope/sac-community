 ==>  message "b equal: 6.46 6.46 OK"
 b equal: 6.46 6.46 OK
 endif
 setbb d (abs( &1,e - &2,e ))
 ==>  setbb d 0
 if %d > 1e-14
 ==>  if 0 > 1e-14
 else
   message "e equal: &1,e &2,e OK"
 ==>  message "e equal: 22.45 22.45 OK"
 e equal: 22.45 22.45 OK
 endif
 setbb d (abs( &1,depmin - &2,depmin ))
 ==>  setbb d 0
 if %d > 1e-14
 ==>  if 0 > 1e-14
 else
   message "depmin equal: &1,depmin &2,depmin OK"
 ==>  message "depmin equal: -1.56928 -1.56928 OK"
 depmin equal: -1.56928 -1.56928 OK
 endif
 setbb d (abs ( &1,depmax - &2,depmax ) )
 ==>  setbb d 0
 if %d > 1e-14
 ==>  if 0 > 1e-14
 else
   message "depmax equal: &1,depmax &2,depmax OK"
 ==>  message "depmax equal: 1.52064 1.52064 OK"
 depmax equal: 1.52064 1.52064 OK
 endif
  
 message "NPTS should be 1600 = &1,npts &2,npts"
 ==>  message "NPTS should be 1600 = 1600 1600"
 NPTS should be 1600 = 1600 1600
 quit
