* this is a SAC macro to generate a sawtooth, approximating a stick-slip source.
echo on
funcgen line -2 1. npts 50 delta 0.01

funcgen impstrin 100 200 300 400 500 600 700 800 900 1000 1100 1200 1300 1400 1500 1600 1700 1800 1900 2000 2100 2200 2300 2400 2500 2600 2700 2800 2900 3000 3100 3200 3300 3400 3500 3600 npts 10000 delta 0.01

write test.impstring.sac

convolve test.impstring.sac

lh depmin depmax depmen b e npts

fg impulse delta 1.0 npts 20
convolve triangle 4
p1 ; pause period 0.25

fg impulse delta 1.0 npts 20
convolve pulse 1
p1 ; pause period 0.25

fg impulse delta 1.0 npts 100
convolve gauss 2.0
p1 ; pause period 0.25

fg impulse delta 1.0 npts 100
convolve gauss 2.0 centered off
p1 ; pause period 0.25

** Errors
fg impulse delta 1.0 npts 20
write test.conv.sac
read test.conv.sac test.conv.sac test.conv.sac
convolve pulse 0
p1 ; pause period 0.25

fg impulse delta 1.0 npts 20
read test.conv.sac test.conv.sac test.conv.sac
convolve pulse 10
p1 ; pause period 0.25

fg impulse delta 1.0 npts 20
convolve non_existant_file
p1 ; pause period 0.25

fg impulse delta 1.0 npts 20
convolve tri 0.1

fg impulse delta 0.04 npts 20
convolve tri 0.1

fg triangle delta 1.0 npts 100
write test.conv1.sac
fg impulse delta 1.0 npts 200
write test.conv2.sac

read test.conv1.sac test.conv2.sac
convolve pulse 1
message "NPTS: &1,npts"
lh npts

read test.conv2.sac
convolve test.conv1.sac
message "NPTS: &1,npts"
lh npts

qdp off
fg seismo
rmean
convolve triangle 0.05 centered off
write test.conv.off.sac

fg seismo
rmean
convolve triangle 0.05 centered on
write test.conv.on.sac

read test.conv.off.sac test.conv.on.sac
color on inc
p2 ; pause period 0.5

** Convolve with Files

fg seismo
rmean
write test.conv.data.sac
lh depmin depmax depmen b e npts

fg triangle delta &1,delta npts 20
write test.conv.pulse.sac
int
setbb SUM &1,depmax
read test.conv.pulse.sac
div %SUM
write over
lh depmin depmax depmen b e npts

read test.conv.data.sac
convolve test.conv.pulse.sac
read more test.conv.data.sac
p2 ; pause period 0.5
lh depmin depmax depmen b e npts

read test.conv.data.sac test.conv.pulse.sac
convolve pulse 2
read more test.conv.data.sac
p2 ; pause period 0.5
lh depmin depmax depmen b e npts

read test.conv.data.sac test.conv.pulse.sac
convolve pulse 1
getbb
